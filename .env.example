# LexLink Configuration Example
#
# The server does NOT read .env by itself. Either export these variables in
# your shell or run:  uv run --env-file .env stdio

# ======================
# Required Configuration
# ======================

# Your law.go.kr API identifier (email local part only)
# Example: if your email is g4c@korea.kr, use: g4c
OC=your_id_here

# ======================
# Optional Configuration
# ======================

# HTTP request timeout in seconds (default: 60)
# LEXLINK_TIMEOUT=60

# Upstream base URL (default: http://www.law.go.kr)
# LEXLINK_BASE_URL=http://www.law.go.kr

# Compact responses for size-limited hosts such as PlayMCP (1/true/yes/on).
# Unset: nothing already fetched is cut.
# SLIM_RESPONSE=true

# ======================
# HTTP server only (uv run serve) - see docs/OPERATIONS.md for the full list
# ======================

# TRANSPORT=http                      # http (recommended, /mcp) or sse (default, /sse)
# HOST=0.0.0.0
# PORT=8000
# LEXLINK_AUTH_TOKENS=name:token      # required unless LEXLINK_ALLOW_NO_AUTH=true
# LEXLINK_ALLOWED_HOSTS=mcp.example.com

# ======================
# Notes
# ======================
#
# OC priority:
#   1. Tool argument (oc parameter in tool call)  - ignored in HTTP mode
#   2. Environment variable (OC above)
#
# To get an OC identifier, register at open.law.go.kr and use your
# email local part (the part before @).
